<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>InterviewGptLicenseTool</RootNamespace>
    <AssemblyName>InterviewGptLicenseTool</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ApplicationIcon>..\InterviewGptBridge\Assets\main_icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\InterviewGptBridge.Licensing\InterviewGptBridge.Licensing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\main_icon.png" Link="Assets\main_icon.png" />
  </ItemGroup>
</Project>
