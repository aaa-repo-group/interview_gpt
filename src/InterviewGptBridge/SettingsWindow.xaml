<Window x:Class="InterviewGptBridge.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#151922"
        Foreground="#F4F7FB"
        Icon="Assets/Browser.ico"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Text="Settings" />

        <StackPanel Grid.Row="1"
                    Margin="0,18,0,0">
            <TextBlock FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#CAD1DD"
                       Text="Privacy" />

            <CheckBox x:Name="SensitiveWindowProtectionCheckBox"
                      Margin="0,14,0,0"
                      Foreground="#F4F7FB"
                      Content="Sensitive Window Protection"
                      Checked="SensitiveWindowProtectionCheckBox_Changed"
                      Unchecked="SensitiveWindowProtectionCheckBox_Changed" />

            <TextBlock Margin="24,6,0,0"
                       Foreground="#AEB7C5"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Text="This feature reduces capture through supported Windows APIs. It cannot prevent every remote-access, administrative, camera, driver-level, or hardware-based capture method." />

            <Border x:Name="SensitiveProtectionStatusPanel"
                    Margin="24,12,0,0"
                    Padding="10,8"
                    CornerRadius="6"
                    Background="#263325"
                    BorderBrush="#4D8A4A"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <TextBlock x:Name="SensitiveProtectionStatusText"
                           Foreground="#D9F7D7"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Margin="0,18,0,0"
                   Foreground="#AEB7C5"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Text="This feature uses documented operating-system APIs only. It does not detect, interfere with, bypass, disable, or conceal activity from remote-session tools, monitoring software, endpoint security tools, administrators, or operating-system security controls." />

        <StackPanel Grid.Row="3"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="84"
                    Height="30"
                    Content="Close"
                    Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
