<Window x:Class="InterviewGptBridge.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="640"
        Height="760"
        SizeToContent="Manual"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#151922"
        Foreground="#F4F7FB"
        Icon="Assets/main_icon.png"
        ShowInTaskbar="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Text="Settings" />

        <StackPanel Grid.Row="1"
                    Margin="0,18,0,0">
            <TextBlock FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#CAD1DD"
                       Text="Privacy" />

            <CheckBox x:Name="SensitiveWindowProtectionCheckBox"
                      Margin="0,14,0,0"
                      Foreground="#F4F7FB"
                      Content="Sensitive Window Protection"
                      Checked="SensitiveWindowProtectionCheckBox_Changed"
                      Unchecked="SensitiveWindowProtectionCheckBox_Changed" />

            <TextBlock Margin="24,6,0,0"
                       Foreground="#AEB7C5"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Text="This feature reduces capture through supported Windows APIs. It cannot prevent every remote-access, administrative, camera, driver-level, or hardware-based capture method." />

            <Border x:Name="SensitiveProtectionStatusPanel"
                    Margin="24,12,0,0"
                    Padding="10,8"
                    CornerRadius="6"
                    Background="#263325"
                    BorderBrush="#4D8A4A"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <TextBlock x:Name="SensitiveProtectionStatusText"
                           Foreground="#D9F7D7"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Margin="0,18,0,0">
            <TextBlock FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#CAD1DD"
                       Text="Window Opacity" />

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="#AEB7C5"
                           FontSize="12"
                           Text="Main window" />
                <Slider x:Name="MainWindowOpacitySlider"
                        Grid.Row="0"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Minimum="0"
                        Maximum="100"
                        TickFrequency="1"
                        ValueChanged="MainWindowOpacitySlider_ValueChanged" />
                <TextBlock x:Name="MainWindowOpacityText"
                           Grid.Row="0"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Foreground="#AEB7C5"
                           FontSize="12" />

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="#AEB7C5"
                           FontSize="12"
                           Text="Caption bridge" />
                <Slider x:Name="CaptionWindowOpacitySlider"
                        Grid.Row="2"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Minimum="0"
                        Maximum="100"
                        TickFrequency="1"
                        ValueChanged="CaptionWindowOpacitySlider_ValueChanged" />
                <TextBlock x:Name="CaptionWindowOpacityText"
                           Grid.Row="2"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Foreground="#AEB7C5"
                           FontSize="12" />
            </Grid>

            <CheckBox x:Name="MainWindowClickThroughCheckBox"
                      Margin="150,12,0,0"
                      Foreground="#F4F7FB"
                      Content="Main window click-through"
                      Checked="MainWindowClickThroughCheckBox_Changed"
                      Unchecked="MainWindowClickThroughCheckBox_Changed" />
        </StackPanel>

        <StackPanel Grid.Row="3"
                    Margin="0,18,0,0">
            <TextBlock FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#CAD1DD"
                       Text="Caption Bridge" />

            <CheckBox x:Name="CaptionAlwaysAboveMainCheckBox"
                      Margin="0,14,0,0"
                      Foreground="#F4F7FB"
                      Content="Always over main window"
                      Checked="CaptionAlwaysAboveMainCheckBox_Changed"
                      Unchecked="CaptionAlwaysAboveMainCheckBox_Changed" />
        </StackPanel>

        <StackPanel Grid.Row="4"
                    Margin="0,18,0,0">
            <TextBlock FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#CAD1DD"
                       Text="Hotkeys" />

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="#AEB7C5"
                           FontSize="12"
                           Text="Toggle caption dialog" />
                <TextBox x:Name="ToggleOverlayHotKeyTextBox"
                         Grid.Row="0"
                         Grid.Column="1"
                         Height="28"
                         Padding="8,4"
                         PreviewKeyDown="HotKeyTextBox_PreviewKeyDown" />

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="#AEB7C5"
                           FontSize="12"
                           Text="Toggle main window" />
                <TextBox x:Name="ToggleMainWindowHotKeyTextBox"
                         Grid.Row="2"
                         Grid.Column="1"
                         Height="28"
                         Padding="8,4"
                         PreviewKeyDown="HotKeyTextBox_PreviewKeyDown" />

                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="#AEB7C5"
                           FontSize="12"
                           Text="Toggle all windows" />
                <TextBox x:Name="ToggleAllWindowsHotKeyTextBox"
                         Grid.Row="4"
                         Grid.Column="1"
                         Height="28"
                         Padding="8,4"
                         PreviewKeyDown="HotKeyTextBox_PreviewKeyDown" />

                <TextBlock Grid.Row="6"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="#AEB7C5"
                           FontSize="12"
                           Text="Main click-through" />
                <TextBox x:Name="ToggleMainClickThroughHotKeyTextBox"
                         Grid.Row="6"
                         Grid.Column="1"
                         Height="28"
                         Padding="8,4"
                         PreviewKeyDown="HotKeyTextBox_PreviewKeyDown" />

                <TextBlock Grid.Row="8"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="#AEB7C5"
                           FontSize="12"
                           Text="Caption click-through" />
                <TextBox x:Name="ToggleCaptionClickThroughHotKeyTextBox"
                         Grid.Row="8"
                         Grid.Column="1"
                         Height="28"
                         Padding="8,4"
                         PreviewKeyDown="HotKeyTextBox_PreviewKeyDown" />

                <TextBlock Grid.Row="10"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="#AEB7C5"
                           FontSize="12"
                           Text="Main opacity up" />
                <TextBox x:Name="IncreaseMainOpacityHotKeyTextBox"
                         Grid.Row="10"
                         Grid.Column="1"
                         Height="28"
                         Padding="8,4"
                         PreviewKeyDown="HotKeyTextBox_PreviewKeyDown" />

                <TextBlock Grid.Row="12"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="#AEB7C5"
                           FontSize="12"
                           Text="Main opacity down" />
                <TextBox x:Name="DecreaseMainOpacityHotKeyTextBox"
                         Grid.Row="12"
                         Grid.Column="1"
                         Height="28"
                         Padding="8,4"
                         PreviewKeyDown="HotKeyTextBox_PreviewKeyDown" />

                <TextBlock Grid.Row="14"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="#AEB7C5"
                           FontSize="12"
                           Text="Caption opacity up" />
                <TextBox x:Name="IncreaseCaptionOpacityHotKeyTextBox"
                         Grid.Row="14"
                         Grid.Column="1"
                         Height="28"
                         Padding="8,4"
                         PreviewKeyDown="HotKeyTextBox_PreviewKeyDown" />

                <TextBlock Grid.Row="16"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="#AEB7C5"
                           FontSize="12"
                           Text="Caption opacity down" />
                <TextBox x:Name="DecreaseCaptionOpacityHotKeyTextBox"
                         Grid.Row="16"
                         Grid.Column="1"
                         Height="28"
                         Padding="8,4"
                         PreviewKeyDown="HotKeyTextBox_PreviewKeyDown" />

                <TextBlock Grid.Row="18"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="#AEB7C5"
                           FontSize="12"
                           Text="Caption font size up" />
                <TextBox x:Name="IncreaseCaptionFontSizeHotKeyTextBox"
                         Grid.Row="18"
                         Grid.Column="1"
                         Height="28"
                         Padding="8,4"
                         PreviewKeyDown="HotKeyTextBox_PreviewKeyDown" />

                <TextBlock Grid.Row="20"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="#AEB7C5"
                           FontSize="12"
                           Text="Caption font size down" />
                <TextBox x:Name="DecreaseCaptionFontSizeHotKeyTextBox"
                         Grid.Row="20"
                         Grid.Column="1"
                         Height="28"
                         Padding="8,4"
                         PreviewKeyDown="HotKeyTextBox_PreviewKeyDown" />

                <TextBlock Grid.Row="22"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="#AEB7C5"
                           FontSize="12"
                           Text="Caption always over main" />
                <TextBox x:Name="ToggleCaptionAboveMainHotKeyTextBox"
                         Grid.Row="22"
                         Grid.Column="1"
                         Height="28"
                         Padding="8,4"
                         PreviewKeyDown="HotKeyTextBox_PreviewKeyDown" />

                <TextBlock Grid.Row="24"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="#AEB7C5"
                           FontSize="12"
                           Text="Capture protection" />
                <TextBox x:Name="ToggleCaptureProtectionHotKeyTextBox"
                         Grid.Row="24"
                         Grid.Column="1"
                         Height="28"
                         Padding="8,4"
                         PreviewKeyDown="HotKeyTextBox_PreviewKeyDown" />
            </Grid>
        </StackPanel>

        <TextBlock Grid.Row="5"
                   Margin="0,18,0,0"
                   Foreground="#AEB7C5"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Text="This feature uses documented operating-system APIs only. It does not detect, interfere with, bypass, disable, or conceal activity from remote-session tools, monitoring software, endpoint security tools, administrators, or operating-system security controls." />

        <StackPanel Grid.Row="6"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="84"
                    Height="30"
                    Content="Close"
                    Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
