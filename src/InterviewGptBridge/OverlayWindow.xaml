<Window x:Class="InterviewGptBridge.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ThanksAAA"
        Width="680"
        Height="280"
        MinWidth="360"
        MinHeight="150"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual"
        Background="#151922"
        Foreground="#F4F7FB"
        Topmost="True"
        Icon="Assets/main_icon.png"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <TextBox x:Name="CaptionTextBox"
                 Grid.Row="0"
                 Padding="12"
                 BorderThickness="0"
                 Background="#151922"
                 Foreground="#F4F7FB"
                 CaretBrush="#F4F7FB"
                 Cursor="Arrow"
                 ForceCursor="True"
                 FontFamily="Segoe UI"
                 FontSize="18"
                 IsReadOnly="True"
                 AcceptsReturn="False"
                 AcceptsTab="False"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 TextWrapping="Wrap"
                 SpellCheck.IsEnabled="False"
                 PreviewMouseLeftButtonDown="CaptionTextBox_PreviewMouseLeftButtonDown"
                 PreviewMouseLeftButtonUp="CaptionTextBox_PreviewMouseLeftButtonUp"
                 PreviewKeyDown="CaptionTextBox_PreviewKeyDown" />

        <Border Grid.Row="1"
                Background="#202632"
                BorderBrush="#343D4B"
                BorderThickness="0,1,0,0">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Slider x:Name="FontSizeSlider"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Minimum="12"
                        Maximum="36"
                        TickFrequency="1"
                        ToolTip="Caption font size"
                        ValueChanged="FontSizeSlider_ValueChanged" />
                <Slider x:Name="CaptionOpacitySlider"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Minimum="0"
                        Maximum="100"
                        TickFrequency="1"
                        ToolTip="Caption window opacity"
                        ValueChanged="CaptionOpacitySlider_ValueChanged" />
            </Grid>
        </Border>
    </Grid>
</Window>
