<Window x:Class="InterviewGptBridge.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Caption Bridge"
        Width="680"
        Height="280"
        MinWidth="360"
        MinHeight="180"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual"
        Background="#151922"
        Foreground="#F4F7FB"
        Topmost="True"
        Icon="Assets/Browser.ico"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#202632"
                BorderBrush="#343D4B"
                BorderThickness="0,0,0,1">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="80" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="SendButton"
                        Grid.Column="0"
                        Width="64"
                        Height="26"
                        Margin="0"
                        Padding="8,2"
                        Content="Send"
                        Click="SendButton_Click" />

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#CAD1DD"
                           Text="Opacity" />

                <Slider x:Name="OpacitySlider"
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Minimum="0.35"
                        Maximum="1"
                        TickFrequency="0.05"
                        ValueChanged="OpacitySlider_ValueChanged" />

                <CheckBox x:Name="TopmostCheckBox"
                          Grid.Column="5"
                          VerticalAlignment="Center"
                          Foreground="#CAD1DD"
                          Content="Top"
                          Checked="TopmostCheckBox_Changed"
                          Unchecked="TopmostCheckBox_Changed" />

                <CheckBox x:Name="PrivacyCheckBox"
                          Grid.Column="7"
                          VerticalAlignment="Center"
                          Foreground="#CAD1DD"
                          Content="Privacy"
                          Checked="PrivacyCheckBox_Changed"
                          Unchecked="PrivacyCheckBox_Changed" />
            </Grid>
        </Border>

        <TextBox x:Name="CaptionTextBox"
                 Grid.Row="1"
                 Padding="12"
                 BorderThickness="0"
                 Background="#151922"
                 Foreground="#F4F7FB"
                 CaretBrush="#F4F7FB"
                 FontFamily="Segoe UI"
                 FontSize="18"
                 AcceptsReturn="False"
                 AcceptsTab="False"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 TextWrapping="Wrap"
                 SpellCheck.IsEnabled="False"
                 PreviewMouseLeftButtonDown="CaptionTextBox_PreviewMouseLeftButtonDown"
                 PreviewMouseLeftButtonUp="CaptionTextBox_PreviewMouseLeftButtonUp"
                 PreviewKeyDown="CaptionTextBox_PreviewKeyDown" />

        <Border x:Name="PrivacyCover"
                Grid.Row="1"
                Panel.ZIndex="10"
                Background="#F2151922"
                Visibility="Collapsed">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#F4F7FB"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Text="Private" />
        </Border>

        <Border Grid.Row="2"
                Background="#202632"
                BorderBrush="#343D4B"
                BorderThickness="0,1,0,0">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CaptureStatusText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#AEB7C5"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ProtectionStatusText"
                           Grid.Column="1"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#D9F7D7"
                           TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed" />
                <TextBlock x:Name="SubmitStatusText"
                           Grid.Column="2"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#AEB7C5" />
            </Grid>
        </Border>
    </Grid>
</Window>
