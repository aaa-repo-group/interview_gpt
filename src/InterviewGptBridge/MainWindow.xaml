<Window x:Class="InterviewGptBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ChatGPT"
        Width="1180"
        Height="820"
        MinWidth="420"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#111418"
        Icon="Assets/main_icon.png"
        ShowInTaskbar="False"
        Topmost="True">
    <Grid>
        <wv2:WebView2 x:Name="Browser" />

        <Border x:Name="StatusBanner"
                Panel.ZIndex="20"
                VerticalAlignment="Top"
                Margin="12"
                Padding="12,8"
                CornerRadius="6"
                Background="#E61B1F26"
                BorderBrush="#34404F"
                BorderThickness="1"
                Visibility="Collapsed">
            <TextBlock x:Name="StatusText"
                       Foreground="#F4F7FB"
                       FontSize="13"
                       TextWrapping="Wrap" />
        </Border>

        <Border x:Name="ProtectionBanner"
                Panel.ZIndex="30"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="12"
                Padding="10,6"
                CornerRadius="6"
                Background="#E6263325"
                BorderBrush="#4D8A4A"
                BorderThickness="1"
                Visibility="Collapsed">
            <TextBlock x:Name="ProtectionStatusText"
                       Foreground="#D9F7D7"
                       FontSize="12"
                       FontWeight="SemiBold" />
        </Border>
    </Grid>
</Window>
